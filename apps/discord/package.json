{
  "name": "@fluffboost/discord",
  "version": "2.0.0",
  "description": "A furry-friendly Discord bot delivering daily motivational quotes with per-guild scheduling, premium subscriptions, and customizable bot presence. Built with Discord.js v14, Drizzle ORM, BullMQ, and Express.",
  "main": "src/app.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/app.ts",
    "dev": "bun --watch src/app.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,js,json}\" && bun run lint",
    "db:push": "bun --bun drizzle-kit push",
    "db:pull": "bun --bun drizzle-kit pull",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:seed": "bun run scripts/seedQuotes.ts",
    "db:reconcile": "bun run scripts/reconcileLegacySchema.ts",
    "test": "NODE_ENV=test bun test --isolate --preload ./tests/preload.ts",
    "test:e2e": "tsc --noEmit -p tsconfig.e2e.json && NODE_ENV=test bun test --isolate --root ./e2e",
    "test:coverage": "NODE_ENV=test bun test --isolate --preload ./tests/preload.ts --coverage"
  },
  "author": "MrDemonWolf, Inc",
  "license": "GPL-3.0-only",
  "dependencies": {
    "bullmq": "^5.66.2",
    "consola": "^3.4.2",
    "dayjs": "^1.11.19",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "5.9.3",
    "postgres": "^3.4.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.1",
    "@types/sinon": "^21.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "prettier": "^3.9.9",
    "sinon": "^21.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
