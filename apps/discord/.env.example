# PostgreSQL connection string for the database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
# Max postgres pool size per process (default 10)
DATABASE_POOL_MAX=10
# Log SQL query text (never parameters) at debug level; development only (default false)
# DATABASE_QUERY_LOG=false

# Redis connection string
REDIS_URL="redis://localhost:6379/0"

# BullMQ worker concurrency per shard (default 4)
WORKER_CONCURRENCY=4

# Discord bot token (required)
DISCORD_APPLICATION_BOT_TOKEN=""
# Optional and currently unused by the bot; validated only when set
# DISCORD_APPLICATION_ID=""
# DISCORD_APPLICATION_PUBLIC_KEY=""

# Discord Default Activity Status
DISCORD_DEFAULT_STATUS="Spreading Paw-sitivity 🐾"
# DISCORD_DEFAULT_ACTIVITY_TYPE can be "Playing", "Streaming", "Listening", or "Custom"
DISCORD_DEFAULT_ACTIVITY_TYPE="Custom"
DEFAULT_ACTIVITY_URL=""
DISCORD_ACTIVITY_INTERVAL_MINUTES=15

# Allowed users to add to the database
ALLOWED_USERS=""
OWNER_ID=""

# Main server announcement channel ID (required)
MAIN_CHANNEL_ID=""
# Optional and currently unused by the bot; validated only when set
# MAIN_GUILD_ID=""

# Premium subscription settings
PREMIUM_ENABLED=false
# Required only when PREMIUM_ENABLED=true; empty counts as unset
# DISCORD_PREMIUM_SKU_ID=

# Health API bind address and port. Unset HOST listens on all interfaces
# (needed inside Docker); PORT must be 1-65535 (default 3000).
# HOST=127.0.0.1
# PORT=3000
# Version shown in /about and /changelog (defaults to package.json version)
# VERSION=
# DEBUG=ioredis:*
# NODE_ENV=production
