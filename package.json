{
  "name": "fluffboost",
  "version": "2.0.0",
  "private": true,
  "description": "FluffBoost monorepo — Discord bot (apps/discord) plus the marketing site and docs (apps/docs).",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:discord": "turbo run dev --filter=@fluffboost/discord",
    "dev:docs": "turbo run dev --filter=@fluffboost/docs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "db:push": "bun run --filter=@fluffboost/discord db:push",
    "db:generate": "bun run --filter=@fluffboost/discord db:generate",
    "db:migrate": "bun run --filter=@fluffboost/discord db:migrate",
    "db:studio": "bun run --filter=@fluffboost/discord db:studio"
  },
  "author": "MrDemonWolf, Inc",
  "license": "GPL-3.0-only",
  "overrides": {
    "qs": ">=6.15.2",
    "hono": ">=4.11.7",
    "undici": ">=7.28.0 <8",
    "lodash": ">=4.17.24",
    "minimatch": ">=9.0.7",
    "serialize-javascript": ">=7.0.3",
    "@hono/node-server": ">=1.19.13",
    "brace-expansion": ">=5.0.7",
    "diff": ">=8.0.3",
    "ip-address": ">=10.1.1",
    "uuid": ">=11.1.1",
    "ws": ">=8.20.1",
    "flatted": ">=3.4.2",
    "path-to-regexp": ">=8.4.0",
    "esbuild": ">=0.25.0",
    "picomatch": ">=4.0.4",
    "form-data": ">=4.0.6",
    "postcss": ">=8.5.18",
    "js-yaml": ">=4.2.0 <5",
    "body-parser": ">=2.3.0",
    "sharp": ">=0.35.0"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
