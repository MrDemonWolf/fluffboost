{
  "name": "fluffboost",
  "version": "2.0.0",
  "private": true,
  "description": "FluffBoost monorepo — Discord bot (apps/discord) plus the marketing site and docs (apps/docs).",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:discord": "turbo run dev --filter=@fluffboost/discord",
    "dev:docs": "turbo run dev --filter=@fluffboost/docs",
    "dev:motion": "bun run --filter=@fluffboost/motion dev",
    "brand:render": "bun run --filter=@fluffboost/motion render",
    "brand:verify": "bun run --filter=@fluffboost/motion test",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@fluffboost/motion",
    "test:e2e": "bun run --filter=@fluffboost/discord test:e2e && bun run --filter=@fluffboost/docs test:e2e",
    "test:coverage": "turbo run test:coverage",
    "db:push": "bun run --filter=@fluffboost/discord db:push",
    "db:generate": "bun run --filter=@fluffboost/discord db:generate",
    "db:migrate": "bun run --filter=@fluffboost/discord db:migrate",
    "db:studio": "bun run --filter=@fluffboost/discord db:studio",
    "db:seed": "bun run --filter=@fluffboost/discord db:seed",
    "db:reconcile": "bun run --filter=@fluffboost/discord db:reconcile"
  },
  "author": "MrDemonWolf, Inc",
  "license": "GPL-3.0-only",
  "overrides": {
    "@types/node": "22.20.1",
    "qs": ">=6.16.0 <7",
    "undici": ">=6.28.1 <7",
    "lodash": ">=4.17.24 <5",
    "diff": ">=8.0.3 <9",
    "ip-address": ">=10.7.1 <11",
    "uuid": ">=11.1.1 <12",
    "ws": ">=8.21.0 <9",
    "flatted": ">=3.4.2 <4",
    "path-to-regexp": ">=8.4.0 <9",
    "esbuild": ">=0.28.1 <0.29",
    "picomatch": ">=4.0.5 <5",
    "form-data": ">=4.0.6 <5",
    "postcss": ">=8.5.23 <9",
    "body-parser": ">=2.3.0 <3",
    "sharp": ">=0.35.5 <0.36",
    "@humanfs/node": ">=0.16.8 <0.17",
    "baseline-browser-mapping": ">=2.11.0 <3",
    "nanoid": ">=3.3.18 <4",
    "proxy-addr": ">=2.0.8 <3",
    "source-map-js": ">=1.2.2 <2"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
